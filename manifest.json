{
  "manifest_version": 3,
  "name": "AlgoTimer - Problem Solving Stopwatch & Timer",
  "version": "1.1.0",
  "description": "Precision stopwatch, concurrent dual countdown timer, and always-on-top pop-up screen for LeetCode, Codeforces, and interview prep.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AlgoTimer - Problem Solving Stopwatch & Timer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.leetcode.com/*",
        "*://*.codeforces.com/*",
        "*://*.hackerrank.com/*",
        "*://*.codechef.com/*",
        "*://*.neetcode.io/*",
        "*://*.geeksforgeeks.org/*",
        "*://*.atcoder.jp/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
