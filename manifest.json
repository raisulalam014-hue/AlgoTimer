{
  "manifest_version": 3,
  "name": "AlgoTimer - Problem Solving Stopwatch & Timer",
  "version": "1.3.0",
  "description": "Problem solving stopwatch and countdown timer with a persistent floating window, Picture-in-Picture option, corner positioning, and global shortcuts.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "windows",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AlgoTimer - Problem Solving Stopwatch & Timer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-timer": {
      "suggested_key": { "default": "Alt+Shift+1" },
      "description": "Start, resume, or pause the active timer",
      "global": true
    },
    "record-lap": {
      "suggested_key": { "default": "Alt+Shift+2" },
      "description": "Record a timer lap",
      "global": true
    },
    "reset-timer": {
      "suggested_key": { "default": "Alt+Shift+3" },
      "description": "Reset the active timer",
      "global": true
    },
    "toggle-floating-window": {
      "suggested_key": { "default": "Alt+Shift+4" },
      "description": "Show or minimize the floating timer",
      "global": true
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "float.html",
        "popup/audio.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
